generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  name            String?
  image           String?
  role            String            @default("USER")
  gender          String?
  city            String?
  hometown        String?
  occupation      String?
  mobile          String?
  dob             String?
  instagram       String?
  createdAt       DateTime          @default(now())
  emailVerified   Boolean           @default(false)
  phone           String?           @unique
  phoneVerified   Boolean           @default(false)
  logs            ActionLog[]
  bookings        Booking[]
  EventReview     EventReview[]
  PhoneOtp        PhoneOtp[]
  reviews         Review[]
  SeatReservation SeatReservation[]
}

model Event {
  id                   String            @id @default(uuid())
  title                String
  description          String
  date                 DateTime
  price                Float             @default(1500)
  femaleDiscount       Float             @default(0)
  genderPricingEnabled Boolean           @default(true)
  minCapacity          Int               @default(10)
  maxCapacity          Int               @default(20)
  status               String            @default("PENDING")
  createdAt            DateTime          @default(now())
  banner               String?
  cancellationPolicy   String?
  category             String?
  faqs                 Json?
  gallery              Json?
  organizerContact     String?
  venue                String?
  bookings             Booking[]
  EventReview          EventReview[]
  SeatReservation      SeatReservation[]
}

model Booking {
  id                  String               @id @default(uuid())
  userId              String
  eventId             String
  razorpayOrderId     String               @unique
  razorpayPaymentId   String?              @unique
  razorpaySignature   String?
  status              String               @default("PENDING")
  createdAt           DateTime             @default(now())
  attendance_status   String               @default("PENDING")
  bookingToken        String?              @unique
  booking_status      String               @default("PENDING")
  finalAmount         Float?
  pricePaid           Float?
  qrCode              String?
  quantity            Int                  @default(1)
  refund_amount       Float?
  refund_status       String?
  reservation_expiry  DateTime?
  taxes               Float?
  ticketNumber        String?              @unique
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  BookingCancellation BookingCancellation?
  EventReview         EventReview?
  RefundTransaction   RefundTransaction[]
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  bookingId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BookingCancellation {
  id            String   @id
  bookingId     String   @unique
  reason        String?
  refundPercent Float
  refundAmount  Float
  createdAt     DateTime @default(now())
  Booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventReview {
  id        String   @id
  eventId   String
  userId    String
  bookingId String   @unique
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PhoneOtp {
  id        String   @id
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RefundTransaction {
  id               String   @id
  bookingId        String
  razorpayRefundId String?
  amount           Float
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  Booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SeatReservation {
  id        String   @id
  eventId   String
  userId    String
  quantity  Int      @default(1)
  expiresAt DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
